# --- Base de données ---
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/restaurant
# SSL : automatique (actif pour une base distante). Forcer avec PGSSL=true ou PGSSL=false si besoin.

# --- Préparation automatique au premier démarrage ---
# Sans ces deux lignes, un compte de test est créé et son mot de passe s'affiche dans les journaux.
# ADMIN_EMAIL=email@exemple.com
# ADMIN_PASSWORD=MotDePasse123
# AUTO_SETUP=false   (désactive le menu d'exemple et le compte automatiques)

# --- Serveur ---
PORT=4000
# Relais devant l'application : 1 = Render seul (valeur normale), 2 = si un relais type Cloudflare s'ajoute devant
TRUST_PROXY=1
# Longue chaîne aléatoire : sert à signer les sessions de l'espace admin
SESSION_SECRET=remplace-moi-par-une-longue-chaine-aleatoire

# --- Informations du restaurant (affichées sur le site) ---
RESTAURANT_NAME=The Burger Bar
RESTAURANT_PHONE=+237 6 00 00 00 00
RESTAURANT_ADDRESS=Adresse du restaurant, Ville
RESTAURANT_HOURS_FR=Tous les jours, 11h - 22h
RESTAURANT_HOURS_EN=Every day, 11am - 10pm
# Photo principale de l'accueil, ex : /img/accueil.jpg (laisser vide pour le burger dessiné)
HERO_IMAGE=
# Frais de livraison en FCFA
DELIVERY_FEE=1000

# --- Notification WhatsApp (API officielle Meta, laisser vide pour désactiver) ---
WA_TOKEN=
WA_PHONE_ID=
# Numéro du restaurant qui reçoit les alertes, format international sans + (ex: 237600000000)
WA_TO=
WA_TEMPLATE=nouvelle_commande
WA_LANG=fr
WA_VERSION=v21.0

# --- Notification Telegram de secours (laisser vide pour désactiver) ---
TG_TOKEN=
TG_CHAT_ID=
